# Copy to ".env" in this folder, or put ".env" one folder above the repo. Placeholders only: never commit real values.

# Required: the course Portkey key. The app uses gpt-6-luna only.
PORTKEY_API_KEY=your-portkey-api-key

# Optional: a Postgres connection string (the hosted app uses Supabase). Without it, a local SQLite file
# (data/coach.db) is created on first start, so nothing else is needed to run locally.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional limits (defaults shown): tokens per student per UTC day, and for the whole site.
# DAILY_TOKEN_BUDGET=300000
# GLOBAL_DAILY_TOKEN_BUDGET=3000000

# Optional: when set, creating an account asks for this code ("Try the demo" never needs it).
# SIGNUP_CODE=

# Optional kill switch: when "1", every AI route answers 503 and no model is called (everything else keeps working).
# AI_PAUSED=0
